rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin only collections
    match /user_queries/{doc} {
      allow read, write: if request.auth != null &&
        (request.auth.token.email == "mukherjipb@gmail.com" ||
         request.auth.token.email == "1legalhelpkolkata@gmail.com");
    }

    match /advocate_registrations/{doc} {
      allow read, write: if request.auth != null &&
        (request.auth.token.email == "mukherjipb@gmail.com" ||
         request.auth.token.email == "1legalhelpkolkata@gmail.com");
      allow create: if true;
    }

    // Public collections
    match /blog_questions/{doc} {
      allow read: if true;
      allow create: if true;
      allow delete, update: if request.auth != null &&
        (request.auth.token.email == "mukherjipb@gmail.com" ||
         request.auth.token.email == "1legalhelpkolkata@gmail.com");
    }

    match /blog_answers/{doc} {
      allow read: if true;
      allow create: if true;
      allow delete, update: if request.auth != null &&
        (request.auth.token.email == "mukherjipb@gmail.com" ||
         request.auth.token.email == "1legalhelpkolkata@gmail.com");
    }

    match /public_advocates/{doc} {
      allow read: if true;
      allow write: if request.auth != null &&
        (request.auth.token.email == "mukherjipb@gmail.com" ||
         request.auth.token.email == "1legalhelpkolkata@gmail.com");
    }
  }
}
